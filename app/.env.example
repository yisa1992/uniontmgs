# Supabase – Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=https://klzribbwimmsxvitmikg.supabase.co

# Public / browser key (publishable or legacy anon)
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...

# REQUIRED for Create / Update / Delete user (server only — never NEXT_PUBLIC_)
# Use secret key (sb_secret_...) OR legacy service_role (eyJ...)
# Do NOT use the publishable key here — that causes "Invalid API key"
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...
# Optional alias (also accepted by the app):
# SUPABASE_SECRET_KEY=sb_secret_...
